diff --git a/src/mwm_tag_slide.c b/src/mwm_tag_slide.c
new file mode 100644
index 0000000..3f16dcf
--- /dev/null
+++ b/src/mwm_tag_slide.c
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: MIT
+#include <libconfig.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "atom.h"
+#include "backend/backend.h"
+#include "common.h"
+#include "log.h"
+#include "mwm_tag_slide.h"
+#include "transition/preset.h"
+#include "transition/script.h"
+#include "utils/misc.h"
+#include "wm/win.h"
+#include "wm/wm.h"
+
+enum {
+	MWM_TAG_BEGIN = 1,
+	MWM_TAG_WINDOW,
+	MWM_TAG_COMMIT,
+	MWM_TAG_CANCEL,
+	MWM_TILE_REFLOW,
+	MWM_TRANSFER_BEGIN,
+	MWM_TRANSFER_ACROSS_BEGIN
+};
+enum { MWM_TAG_VIEWS = 1, MWM_TAG_TRANSFERS = 2 };
+enum slide_kind { TAG_VIEW, WINDOW_TRANSFER, WINDOW_TRANSFER_ACROSS };
+// Encoding of the first argument to MWM_TAG_COMMIT.
+enum mwm_slide_easing { MWM_EASE_OUT = 0, MWM_EASE_IN_OUT, MWM_EASE_LINEAR };
+enum { MAX_SLIDE_WINDOWS = 4096, MAX_SLIDE_DURATION = 500, COMMIT_TIMEOUT = 250 };
+enum { MWM_ENTER = 1, MWM_EXIT = 2, MWM_REFLOW = 4 };
+
+struct tag_window {
+	xcb_window_t id;
+	ivec2 origin;
+	bool outgoing;
+};
+
+struct mwm_tag_slide {
+	struct mwm_tag_slide *next;
+	struct ibox monitor;
+	ivec2 destination, old_size;
+	struct tag_window *windows;
+	size_t count, capacity;
+	int direction, duration;
+	double progress;
+	enum slide_kind kind;
+	enum mwm_slide_easing easing;
+	int64_t requested, started;
+	bool committed;
+};
+
+static int64_t motion_now(void) {
+	struct timespec now = get_time_timespec();
+	return now.tv_sec * 1000LL + now.tv_nsec / 1000000;
+}
+
+static void mwm_window_motion_init(struct session *ps) {
+	static const char presets[] =
+	    "effects = ("
+	    "{ preset = \"appear\"; scale = 0.96; duration = 0.185; },"
+	    "{ preset = \"disappear\"; scale = 0.96; duration = 0.14; },"
+	    "{ preset = \"geometry-change\"; duration = 0.185; }"
+	    ");";
+	config_t config;
+	config_init(&config);
+	if (config_read_string(&config, presets)) {
+		config_setting_t *effects = config_lookup(&config, "effects");
+		for (unsigned i = 0; i < ARR_SIZE(ps->mwm_window_animations); i++) {
+			config_setting_t *preset = config_setting_get_elem(effects, i);
+			win_script_parse_preset(&ps->mwm_window_animations[i], preset);
+		}
+	}
+	config_destroy(&config);
+}
+
+void mwm_window_motion_free(struct session *ps) {
+	for (unsigned i = 0; i < ARR_SIZE(ps->mwm_window_animations); i++) {
+		if (ps->mwm_window_animations[i].script != NULL) {
+			script_free(ps->mwm_window_animations[i].script);
+		}
+	}
+}
+
+void mwm_window_motion_update(struct session *ps) {
+	winprop_t prop = x_get_prop(&ps->c, ps->c.screen_info->root,
+	                            ps->mwm_window_motion_atom, 1, XCB_ATOM_CARDINAL, 32);
+	ps->mwm_window_motion_active = prop.nitems == 1;
+	ps->mwm_window_motion_mask = ps->mwm_window_motion_active ? prop.c32[0] : 0;
+	free_winprop(&prop);
+}
+
+const struct win_script *
+mwm_window_motion_script(struct session *ps, struct win *w, enum animation_trigger trigger,
+                         unsigned *kind, const struct win_script *fallback) {
+	if (!ps->mwm_window_motion_active || !w->mwm_client) {
+		return fallback;
+	}
+	unsigned index;
+	switch (trigger) {
+	case ANIMATION_TRIGGER_OPEN:
+	case ANIMATION_TRIGGER_SHOW: index = 0; break;
+	case ANIMATION_TRIGGER_CLOSE:
+	case ANIMATION_TRIGGER_HIDE: index = 1; break;
+	case ANIMATION_TRIGGER_SIZE:
+	case ANIMATION_TRIGGER_POSITION:
+		if (w->mwm_reflow_until == 0 || motion_now() > w->mwm_reflow_until) {
+			return fallback;
+		}
+		w->mwm_reflow_until = 0;
+		index = 2;
+		break;
+	default: return fallback;
+	}
+
+	*kind = 1u << index;
+	return ps->mwm_window_motion_mask & *kind ? &ps->mwm_window_animations[index] : NULL;
+}
+
+void mwm_tag_slide_register(struct session *ps) {
+	const char *backend = backend_name(ps->o.backend);
+	if (!ps->o.vsync || (strcmp(backend, "glx") && strcmp(backend, "egl"))) {
+		return;
+	}
+	char name[48];
+	snprintf(name, sizeof(name), "_MWM_TAG_SLIDE_V1_S%d", ps->c.screen);
+	ps->mwm_tag_slide_atom = get_atom_with_nul(ps->atoms, name, ps->c.c);
+	if (ps->mwm_tag_slide_atom != XCB_ATOM_NONE) {
+		ps->mwm_window_motion_atom =
+		    get_atom_with_nul(ps->atoms, "_MWM_WINDOW_MOTION_V1", ps->c.c);
+		mwm_window_motion_init(ps);
+		mwm_window_motion_update(ps);
+		xcb_set_selection_owner(ps->c.c, ps->reg_win, ps->mwm_tag_slide_atom,
+		                        XCB_CURRENT_TIME);
+	}
+}
+
+static void remove_slide(struct mwm_tag_slide **slot) {
+	struct mwm_tag_slide *slide = *slot;
+	*slot = slide->next;
+	free(slide->windows);
+	free(slide);
+}
+
+void mwm_tag_slide_clear(struct session *ps) {
+	while (ps->mwm_tag_slides != NULL) {
+		remove_slide(&ps->mwm_tag_slides);
+	}
+}
+
+static void remove_monitor_slides(struct mwm_tag_slide **slot, ivec2 origin) {
+	while (*slot) {
+		struct mwm_tag_slide *slide = *slot;
+		if (ivec2_eq(slide->monitor.origin, origin) ||
+		    (slide->kind == WINDOW_TRANSFER_ACROSS && slide->committed &&
+		     ivec2_eq(slide->destination, origin))) {
+			remove_slide(slot);
+		} else {
+			slot = &slide->next;
+		}
+	}
+}
+
+static void begin_slide(struct session *ps, const uint32_t *data, enum slide_kind kind) {
+	if (ps->mwm_tag_slides && !ps->mwm_tag_slides->committed) {
+		remove_slide(&ps->mwm_tag_slides);
+	}
+	int x = (int32_t)data[1], y = (int32_t)data[2];
+	int width = (int)(data[3] >> 16), height = (int)(data[3] & 0xffff);
+	int duration = (int32_t)data[4];
+	if (!ps->redirected || width == 0 || height == 0 || x < 0 || y < 0 ||
+	    x > ps->root_width - width || y > ps->root_height - height ||
+	    duration < -MAX_SLIDE_DURATION || duration > MAX_SLIDE_DURATION || duration == 0) {
+		return;
+	}
+
+	// Replace an interrupted slide on this monitor. Others finish independently.
+	remove_monitor_slides(&ps->mwm_tag_slides, (ivec2){x, y});
+
+	struct mwm_tag_slide *slide = ccalloc(1, struct mwm_tag_slide);
+	*slide = (struct mwm_tag_slide){
+	    .next = ps->mwm_tag_slides,
+	    .monitor = {{x, y}, {width, height}},
+	    .kind = kind,
+	    .direction = duration > 0 ? 1 : -1,
+	    .duration = abs(duration),
+	    .requested = motion_now(),
+	};
+	ps->mwm_tag_slides = slide;
+}
+
+static int compare_window(const void *a, const void *b) {
+	xcb_window_t left = ((const struct tag_window *)a)->id;
+	xcb_window_t right = ((const struct tag_window *)b)->id;
+	return (left > right) - (left < right);
+}
+
+void mwm_tag_slide_event(struct session *ps, const xcb_client_message_event_t *event) {
+	if (ps->mwm_tag_slide_atom == XCB_ATOM_NONE || event->window != ps->reg_win ||
+	    event->type != ps->mwm_tag_slide_atom || event->format != 32) {
+		return;
+	}
+	const uint32_t *data = event->data.data32;
+	if (data[0] == MWM_TILE_REFLOW) {
+		if (ps->mwm_window_motion_mask & MWM_REFLOW) {
+			auto ref = wm_find(ps->wm, data[1]);
+			auto w = ref ? wm_ref_deref(ref) : NULL;
+			if (w != NULL && w->state == WSTATE_MAPPED) {
+				w->mwm_reflow_until = motion_now() + COMMIT_TIMEOUT;
+			}
+		}
+		return;
+	}
+	if (data[0] == MWM_TAG_CANCEL) {
+		for (struct mwm_tag_slide **slot = &ps->mwm_tag_slides; *slot;) {
+			unsigned kind = (*slot)->kind == TAG_VIEW ? MWM_TAG_VIEWS : MWM_TAG_TRANSFERS;
+			if (!data[1] || (data[1] & kind)) {
+				remove_slide(slot);
+			} else {
+				slot = &(*slot)->next;
+			}
+		}
+		return;
+	}
+	switch (data[0]) {
+	case MWM_TAG_BEGIN: begin_slide(ps, data, TAG_VIEW); return;
+	case MWM_TRANSFER_BEGIN: begin_slide(ps, data, WINDOW_TRANSFER); return;
+	case MWM_TRANSFER_ACROSS_BEGIN:
+		begin_slide(ps, data, WINDOW_TRANSFER_ACROSS);
+		return;
+	default: break;
+	}
+	struct mwm_tag_slide *slide = ps->mwm_tag_slides;
+	if (!slide || slide->committed) {
+		return;
+	}
+	if (data[0] == MWM_TAG_COMMIT) {
+		if (slide->count == 0) {
+			remove_slide(&ps->mwm_tag_slides);
+			return;
+		}
+		if (slide->kind == WINDOW_TRANSFER_ACROSS) {
+			slide->old_size = (ivec2){(int)(data[2] >> 16), (int)(data[2] & 0xffff)};
+			slide->destination = (ivec2){(int32_t)data[3], (int32_t)data[4]};
+			if (slide->old_size.width == 0 || slide->old_size.height == 0 ||
+			    slide->destination.x < 0 || slide->destination.x >= ps->root_width ||
+			    slide->destination.y < 0 || slide->destination.y >= ps->root_height) {
+				remove_slide(&ps->mwm_tag_slides);
+				return;
+			}
+			remove_monitor_slides(&slide->next, slide->destination);
+		}
+		qsort(slide->windows, slide->count, sizeof(*slide->windows), compare_window);
+		slide->easing = data[1] <= MWM_EASE_LINEAR ? (enum mwm_slide_easing)data[1]
+		                                           : MWM_EASE_OUT;
+		slide->committed = true;
+		log_debug("MWM %s at %d,%d, direction %d, duration %d ms",
+		          slide->kind == TAG_VIEW ? "tag slide" :
+		          slide->kind == WINDOW_TRANSFER_ACROSS ? "cross-monitor transfer" :
+		          "tag transfer",
+		          slide->monitor.origin.x, slide->monitor.origin.y,
+		          slide->direction, slide->duration);
+		return;
+	}
+	int x = (int32_t)data[3], y = (int32_t)data[4];
+	if (data[0] != MWM_TAG_WINDOW || data[1] == XCB_NONE || data[2] > 1 ||
+	    x < INT16_MIN || x > INT16_MAX || y < INT16_MIN || y > INT16_MAX ||
+	    slide->count == (slide->kind == TAG_VIEW ? MAX_SLIDE_WINDOWS : 1)) {
+		return;
+	}
+	if (slide->count == slide->capacity) {
+		slide->capacity = slide->capacity == 0 ? 8 : slide->capacity * 2;
+		slide->windows = crealloc(slide->windows, slide->capacity);
+	}
+	slide->windows[slide->count++] = (struct tag_window){data[1], {x, y}, data[2] != 0};
+}
+
+static double eased_progress(enum mwm_slide_easing easing, double t) {
+	switch (easing) {
+	case MWM_EASE_LINEAR: return t;
+	case MWM_EASE_IN_OUT: return t * t * (3.0 - 2.0 * t);
+	case MWM_EASE_OUT: {
+		double remaining = 1.0 - t;
+		return 1.0 - remaining * remaining * remaining;
+	}
+	}
+	return t;
+}
+
+bool mwm_tag_slide_frame(struct session *ps, int64_t now) {
+	for (struct mwm_tag_slide **slot = &ps->mwm_tag_slides; *slot;) {
+		struct mwm_tag_slide *slide = *slot;
+		if (slide->committed && slide->started == 0) {
+			slide->started = now;
+		}
+		if (slide->committed ? now - slide->started >= slide->duration
+		                     : now - slide->requested >= COMMIT_TIMEOUT) {
+			remove_slide(slot);
+			continue;
+		}
+		if (slide->committed) {
+			double t = (double)(now - slide->started) / slide->duration;
+			slide->progress = eased_progress(slide->easing, t);
+		}
+		slot = &slide->next;
+	}
+	return ps->mwm_tag_slides != NULL;
+}
+
+static struct mwm_tag_placement place_window(const struct mwm_tag_slide *slide,
+                                             const struct tag_window *window,
+                                             struct ibox bounds) {
+	struct mwm_tag_placement placement = {
+	    .origin = window->outgoing ? window->origin : bounds.origin,
+	    .clip = slide->monitor,
+	    .scale = {1.0, 1.0},
+	};
+	double p = slide->progress;
+	if (slide->kind == WINDOW_TRANSFER_ACROSS) {
+		placement.origin.x = (int)lround(window->origin.x * (1.0 - p) + bounds.origin.x * p);
+		placement.origin.y = (int)lround(window->origin.y * (1.0 - p) + bounds.origin.y * p);
+		placement.clip = (struct ibox){.size = {INT_MAX, INT_MAX}};
+		if (slide->committed) {
+			placement.scale.x = p + (double)slide->old_size.width / bounds.size.width * (1.0 - p);
+			placement.scale.y = p + (double)slide->old_size.height / bounds.size.height * (1.0 - p);
+		}
+		return placement;
+	}
+
+	int distance = slide->direction * slide->monitor.size.width;
+	int dx = (int)lround(distance * (window->outgoing ? p : p - 1.0));
+	if (slide->kind == TAG_VIEW) {
+		dx = -dx;
+		// Keep the two tags on their own sides of the moving seam.
+		placement.clip.origin.x += max2(dx, 0);
+		placement.clip.size.width -= abs(dx);
+	}
+	placement.origin.x += dx;
+	return placement;
+}
+
+bool mwm_tag_slide_place(const struct mwm_tag_slide *slides, xcb_window_t win,
+                         struct ibox bounds, struct mwm_tag_placement *placement) {
+	for (const struct mwm_tag_slide *slide = slides; slide; slide = slide->next) {
+		const struct tag_window *window = NULL;
+		if (slide->committed) {
+			struct tag_window key = {.id = win};
+			window = bsearch(&key, slide->windows, slide->count,
+			                 sizeof(*slide->windows), compare_window);
+		} else {
+			for (size_t i = 0; i < slide->count; ++i) {
+				if (slide->windows[i].id == win) {
+					window = &slide->windows[i];
+					break;
+				}
+			}
+		}
+		if (!window) {
+			continue;
+		}
+		if (placement) {
+			*placement = place_window(slide, window, bounds);
+		}
+		return true;
+	}
+	return false;
+}
