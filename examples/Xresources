! Example mwm styling via Xresources. Load before starting mwm:
!     xrdb -merge ~/.Xresources       (or this file)
! Then run mwmc reload. Unset resources keep the config.ini or compiled default.
! Colors are #rrggbb; alphas accept 0xNN or decimal (0..255); mfact is a float.

mwm.font:            Geist:pixelsize=18
mwm.monofont:        Geist Mono

! left pill + normal tags
mwm.normfg:          #c0caf5
mwm.normbg:          #1a1b26
mwm.normborder:      #3b4261
! selected tag + focused window border
mwm.selfg:           #1a1b26
mwm.selbg:           #7aa2f7
mwm.selborder:       #7aa2f7
! urgent tag
mwm.urgfg:           #1a1b26
mwm.urgbg:           #f7768e
mwm.urgborder:       #f7768e
! focused title pill
mwm.titlefg:         #c0caf5
mwm.titlebg:         #1a1b26
! right status pill
mwm.statusfg:        #c0caf5
mwm.statusbg:        #1a1b26
! warning and danger colors for charts and symbolic tray icons
mwm.systemwarn:      #e0af68
mwm.systemdanger:    #ff5266
! symbolic tray icon success color (regular foreground uses mwm.selbg)
mwm.traysuccess:     #9ece6a
! bar background behind/around the pills. barbgalpha 0 = transparent bar with
! floating pills; raise it (e.g. 0xff) for a solid, contrasted bar strip.
mwm.barbg:           #16161e
mwm.barbgalpha:      0x00

! pill background translucency (needs a compositor to actually show)
! mwm.normbgalpha:   0xff
! mwm.selbgalpha:    0xff
! mwm.urgbgalpha:    0xff
! mwm.titlebgalpha:  0xff
! mwm.statusbgalpha: 0xff

! geometry / spacing
mwm.borderpx:        4
mwm.gappx:           10
mwm.cornerradius:    3
mwm.segradius:       6
mwm.tagradius:       3
mwm.barfontsize:     16
mwm.barpadx:         12
mwm.barvertpad:      6
mwm.barmargin:       6
mwm.barvmargin:      6
mwm.barseggap:       10
mwm.mfact:           0.55
